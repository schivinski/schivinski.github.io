```{=html}
<div class="watch-list">
<% for (const item of items) { %><article class="watch-item" <%= metadataAttrs(item) %>><% if (item.image) { %><a class="watch-thumb" href="<%- item.path %>" tabindex="-1" aria-hidden="true"><img src="<%- item.thumb || item.image %>" alt="<%= item['image-alt'] || '' %>" loading="lazy" decoding="async" width="640" height="336"></a><% } %><div><p class="watch-meta"><% if (item.issue) { %>Issue <%= item.issue %> · <% } %><time datetime="<%- item.date %>"><%= item.dateline || ('Week of ' + item.date) %></time></p><h3><a href="<%- item.path %>"><%= item.title %></a></h3><% if (item.description) { %><p><%= item.description %></p><% } %></div></article>
<% } %></div>
```
